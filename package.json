{
  "name": "mapik",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "repository": "github:aweebit/mapik",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./Drizzle/*": "./dist/Drizzle/*.js"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "rimraf dist && tsc"
  },
  "peerDependencies": {
    "drizzle-orm": "^1.0.0-rc.1",
    "kysely": "^0.29.4"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  },
  "devDependencies": {
    "drizzle-orm": "^1.0.0-rc.4",
    "effect": "^4.0.0-beta.102",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true
  }
}
