{
  "name": "mapik",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "repository": "github:aweebit/mapik",
  "exports": {
    ".": "./dist/index.js",
    "./drizzle": "./dist/drizzle/index.js",
    "./drizzle/kysely": "./dist/drizzle/kysely/index.js",
    "./*": "./dist/*"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "drizzle-orm": "^1.0.0-rc.1",
    "kysely": ">=0.15.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  },
  "devDependencies": {
    "drizzle-orm": "^1.0.0-rc.4",
    "kysely": "^0.29.5",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
